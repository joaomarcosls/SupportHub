# ==============================================================================
# SupportHub - Variáveis de Ambiente e Configuração (.env)
# ==============================================================================
# Instruções: Copie ou renomeie este arquivo para ".env" na raiz do projeto antes
# de iniciar o sistema via Docker Compose: docker compose up -d

# ------------------------------------------------------------------------------
# 1. Configuração do Servidor e Aplicação
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Chave secreta para criptografia de tokens JWT de sessão de usuário
JWT_SECRET=super_secret_jwt_key_supporthub_2026_production

# ------------------------------------------------------------------------------
# 2. Configuração do Banco de Dados PostgreSQL (Container Docker)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supporthub_db
POSTGRES_USER=supporthub_user
POSTGRES_PASSWORD=supporthub_secure_pass

# String de conexão completa usada pela API Node.js Express
DATABASE_URL=postgres://supporthub_user:supporthub_secure_pass@postgres:5432/supporthub_db

# ------------------------------------------------------------------------------
# 3. Conta Inicial de Administrador do Sistema (Criada no Seed/Migration)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@empresa.com.br
INITIAL_ADMIN_PASSWORD=123456
