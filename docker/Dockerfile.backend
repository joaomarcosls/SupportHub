# Backend Dockerfile - Git Clone Automático durante a compilação
FROM node:20-alpine AS builder

# Parâmetros de build para clonar o repositório
ARG REPO_URL=https://github.com/joaomarcosls/SupportHub.git
ARG BRANCH_VERSION=main
ARG GIT_AUTH_TOKEN=""

# Instalar o git no container do builder
RUN apk add --no-cache git

WORKDIR /app

# Clonar o repositório diretamente do GitHub
RUN if [ -n "$GIT_AUTH_TOKEN" ]; then \
        git clone https://${GIT_AUTH_TOKEN}:x-oauth-basic@${REPO_URL#https://} --branch ${BRANCH_VERSION} . ; \
    else \
        git clone ${REPO_URL} --branch ${BRANCH_VERSION} . ; \
    fi

# Instalar dependências e realizar a compilação do TypeScript/Vite
RUN npm install
RUN npm run build

# Estágio Final de Produção
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package*.json ./
RUN npm install --omit=dev

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "dist/server.cjs"]
