# ==============================================================================
# SupportHub - Variáveis de Ambiente e Configuração (.env)
# ==============================================================================
# Instruções: Copie este arquivo para ".env" antes de executar:
# docker compose -f docker/docker-compose.yml up -d --build

# ------------------------------------------------------------------------------
# 1. Configurações da Aplicação e Servidor
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:8383

# Chave secreta usada para assinar os tokens de autenticação (JWT)
JWT_SECRET=secreto_jwt_super_seguro_supporthub_2026_prod

# ------------------------------------------------------------------------------
# 2. Configurações do Banco de Dados PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supporthub_db
POSTGRES_USER=supporthub_user
POSTGRES_PASSWORD=SupporthubSecure2026!Pass

# ------------------------------------------------------------------------------
# 3. Parâmetros de Build do Docker (Git Clone Automático)
# ------------------------------------------------------------------------------
# Repositório GitHub de onde o Docker vai clonar o código fonte durante o build
REPO_URL=https://github.com/joaomarcosls/SupportHub.git

# Branch que será utilizada para a compilação
BRANCH_VERSION=main

# Token de autenticação (Necessário APENAS se o repositório for privado)
GIT_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. Integração com IA (Google Gemini API - Opcional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
